# Copy this file to .env before running the server (or just set these as
# real environment variables on whatever host you run it on — e.g. your
# Vercel project's Settings -> Environment Variables).

# Postgres connection string (Neon). Required -- the server won't start
# meaningfully without it. Get this from your Neon project's dashboard,
# or from the Vercel/Neon integration if you connected one there.
DATABASE_URL=

# Port the server listens on when run locally with `node server.js`.
# Not used on Vercel (Vercel manages the port itself).
PORT=4000

# Optional but recommended if this server will be reachable on the public
# internet: any random string. When set, every request to the site must
# include this same value in an "X-API-Key" header, or it's rejected.
# Leave blank for local-only testing.
API_KEY=
